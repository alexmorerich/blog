---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a href="/" class="site-title">{SITE_TITLE}</a>
		<div class="nav-links">
			<HeaderLink href="/">Posts</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<a href="/rss.xml">RSS</a>
		</div>
	</nav>
</header>
<style>
	header {
		padding: 0 1em;
		background: white;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	nav {
		max-width: 720px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 48px;
	}
	.site-title {
		font-weight: 700;
		color: rgb(var(--black));
		text-decoration: none;
		font-size: 1rem;
	}
	.nav-links {
		display: flex;
		gap: 1.5em;
		align-items: center;
	}
	.nav-links a {
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-size: 0.9rem;
		padding: 0;
		border: none;
	}
	.nav-links a:hover,
	.nav-links a.active {
		color: var(--accent);
		border: none;
	}
</style>
