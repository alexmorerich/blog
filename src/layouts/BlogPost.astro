---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, tags, source } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
			}
			.post-header {
				margin-bottom: 2em;
				padding-bottom: 1em;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.post-header time {
				display: block;
				font-size: 0.85rem;
				color: rgb(var(--gray));
				margin-bottom: 0.5em;
			}
			.post-header h1 {
				margin: 0 0 0.5em;
			}
			.updated {
				display: block;
				font-size: 0.8rem;
				color: rgb(var(--gray));
				font-style: italic;
				margin-top: 0.25em;
			}
			.source-link {
				margin-top: 2em;
				padding-top: 1em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.source-link a {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				font-size: 0.9rem;
				color: rgb(var(--gray));
				text-decoration: none;
				padding: 0.5em 1em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 6px;
				transition: color 0.15s, border-color 0.15s;
			}
			.source-link a:hover {
				color: var(--accent);
				border-color: var(--accent);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article>
				<div class="prose">
					<div class="post-header">
						<time><FormattedDate date={pubDate} /></time>
						{
							updatedDate && (
								<span class="updated">
									Updated: <FormattedDate date={updatedDate} />
								</span>
							)
						}
						<h1>{title}</h1>
						{
							tags && tags.length > 0 && (
								<div class="tags">
									{tags.map((tag) => (
										<a href={`/tags/${tag}/`} class="tag">
											{tag}
										</a>
									))}
								</div>
							)
						}
					</div>
					<slot />
					{source && (
						<div class="source-link">
							<a href={source} target="_blank" rel="noopener noreferrer">
								▶ 在小红书上查看原帖
							</a>
						</div>
					)}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
